# ---- Application ----
# development | test | production
APP_ENV=development
# Any random string; required. Never commit a real value.
APP_SECRET_KEY=change-me
# Port uvicorn listens on
BACKEND_PORT=8000
# The only origin allowed by CORS (the Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173
# Log level for JSON logs
LOG_LEVEL=INFO

# ---- PostgreSQL (docker compose service) ----
# Required. SQLAlchemy URL using the psycopg 3 driver
DATABASE_URL=postgresql+psycopg://dealbridge:dealbridge@localhost:5433/dealbridge

# ---- Qdrant (docker compose service) ----
# Required. Qdrant REST endpoint
QDRANT_URL=http://localhost:6333
# Optional API key (empty for the local container)
QDRANT_API_KEY=
# Collection holding official OKF knowledge chunks
QDRANT_OFFICIAL_COLLECTION=official_product_knowledge
# Collection holding approved expert resolutions
QDRANT_RESOLVED_COLLECTION=resolved_query_knowledge

# ---- LLM (single provider: Qwen via Alibaba Cloud Model Studio, OpenAI-compatible API) ----
# Only 'qwen' is accepted
LLM_PROVIDER=qwen
# Your DashScope / Model Studio API key. Empty = LLM features return 503 LLM_NOT_CONFIGURED
LLM_API_KEY=
# OpenAI-compatible endpoint (international region by default)
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Main model: extraction, assessment, answers
LLM_MODEL=qwen3.8-max
# Fast model: classification, rewriting, duplicate checks, faithfulness checks
LLM_FAST_MODEL=qwen3.8-flash
# Timeout per main-model call (seconds)
LLM_TIMEOUT_SECONDS=60
# Timeout per fast-model call (seconds)
LLM_FAST_TIMEOUT_SECONDS=20
# Retries on rate limits, 5xx, timeouts
LLM_MAX_RETRIES=2

# ---- Embeddings (local, no API cost) ----
# Only 'fastembed' is accepted
EMBEDDING_PROVIDER=fastembed
# One model for every collection and query; changing it requires a reindex
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Vector size of the model above
EMBEDDING_DIMENSION=384
# Where the model files are cached (git-ignored)
FASTEMBED_CACHE_DIR=./.cache/fastembed

# ---- Retrieval and answer thresholds (calibrated in Gate G2; see docs/DECISIONS.md) ----
# Hits below this cosine score are dropped
RETRIEVAL_MIN_SCORE=0.60
# A resolved answer at or above this score may be reused
RESOLVED_REUSE_MIN_SCORE=0.70
# Hits taken from the official collection
TOP_K_OFFICIAL=6
# Hits taken from the resolved collection
TOP_K_RESOLVED=4
# Similarity above which an open ticket is checked as a duplicate
TICKET_DUP_MIN_SCORE=0.85
# Second-stage LLM faithfulness check on answers
ENABLE_FAITHFULNESS_CHECK=true
# Let one admin both propose and approve (both are still recorded)
ALLOW_SELF_APPROVAL=true

# ---- Files ----
# Where uploads are stored (git-ignored; outside any static directory)
UPLOAD_DIR=./uploads
# Maximum upload size in MB
MAX_UPLOAD_MB=20
# Maximum PDF pages accepted
MAX_PDF_PAGES=200

# ---- Knowledge ----
# OKF bundle root
OKF_BUNDLE_DIR=./knowledge/official/iomete
